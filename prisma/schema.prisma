generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "mysql"
}

model Account {
  id                  String       @id @default(cuid())
  account_no          Int          @unique
  account_name        String
  balance             Float?       @default(0)
  account_type        String
  header              String
  bank                String
  account_category    String?
  date_created        DateTime     @default(now())
  last_updated_at     DateTime     @updatedAt
  account_type_no     Int          @default(1)
  account_description String?
  fs_category         String?
  account_status      String       @default("Active")
  account_type_id     String?
  accountTypeRel      AccountType? @relation(fields: [account_type_id], references: [id])
  
  // Profit & Cost Center relations
  profit_center_id    String?      @db.VarChar(2)
  cost_center_id      String?      @db.VarChar(2)
  profitCenter        ProfitCenter? @relation(fields: [profit_center_id], references: [id])
  costCenter          CostCenter?   @relation(fields: [cost_center_id], references: [id])

  // GL Mapping fields
  linked_gl_id        String?
  opening_balance     Float?       @default(0)
  opening_date        DateTime?
  bankAccounts        BankAccount[]

  @@map("chart_of_account")
}

model BankAccount {
  id              String      @id @default(cuid())
  bank_code       String      @unique
  bank_name       String
  account_name    String
  account_number  String
  account_type    AccountTypeEnum
  currency        String?     @default("PHP")
  gl_account_id   String
  gl_account      Account     @relation(fields: [gl_account_id], references: [id])
  opening_balance Float?      @default(0)
  opening_date    DateTime?
  is_active       Boolean     @default(true)
  audit_status    AuditStatus @default(TO_AUDIT)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt
  bank_transactions BankTransaction[]
  reconciliations   BankReconciliation[]

  @@map("bank_accounts")
}

enum AccountTypeEnum {
  CASH
  BANK
}

enum AuditStatus {
  DRAFT
  TO_AUDIT
  ONGOING
  DONE
}

model AccountType {
  id        String    @id @default(cuid())
  name      String    @unique
  baseType  String    @default("Asset")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  accounts  Account[]

  @@map("account_type")
}

model Transaction {
  id                 String    @id @default(cuid())
  seq                Int?
  ledger             String?
  transNo            String?
  code               String?
  accountNumber      String?
  date               DateTime?
  invoiceNumber      String?
  particulars        String?
  debit              Float?    @default(0)
  credit             Float?    @default(0)
  balance            Float?    @default(0)
  checkAccountNumber String?
  checkNumber        String?
  dateMatured        DateTime?
  accountName        String?
  bankName           String?
  bankBranch         String?
  user               String?
  isCoincide         Boolean?
  dailyClosing       Int?
  approval           String?
  ftToLedger         String?
  ftToAccount        String?
  ssma_timestamp     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Profit & Cost Center relations
  profit_center_id   String?   @db.VarChar(2)
  cost_center_id     String?   @db.VarChar(2)
  profitCenter       ProfitCenter? @relation(fields: [profit_center_id], references: [id])
  costCenter         CostCenter?   @relation(fields: [cost_center_id], references: [id])
  
  branchId           String?
  branch             Branch?   @relation(fields: [branchId], references: [id])

  @@index([accountNumber, date])
  @@index([code, date])
  @@index([date])
  @@map("transactions")
}

model LoyaltyPointSetting {
  id              String         @id @default(cuid())
  description     String
  amount          Float          @default(0)
  equivalentPoint Float          @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  loyaltyPoints   LoyaltyPoint[]

  @@map("loyalty_point_setting")
}

model Customer {
  id                        String         @id @default(cuid())
  code                      String         @unique
  customerName              String
  contactFirstName          String?
  address                   String?
  phonePrimary              String?
  phoneAlternative          String?
  email                     String?
  isActive                  Boolean        @default(true)
  creditLimit               Float?         @default(0)
  isTaxExempt               Boolean        @default(false)
  paymentTerms              String?        @default("days")
  paymentTermsValue         String?        @default("30")
  salesperson               String?
  customerGroup             String?        @default("default")
  isEntitledToLoyaltyPoints Boolean        @default(false)
  pointSetting              String?
  loyaltyCalculationMethod  String?        @default("automatic")
  loyaltyCardNumber         String?
  createdAt                 DateTime       @default(now())
  updatedAt                 DateTime       @updatedAt
  invoices                  Invoice[]
  loyaltyPoints             LoyaltyPoint[]

  @@map("customer")
}

model LoyaltyPoint {
  id             String              @id @default(cuid())
  customerId     String
  loyaltyCardId  String
  totalPoints    Float               @default(0)
  pointSettingId String
  expiryDate     DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  customer       Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  pointSetting   LoyaltyPointSetting @relation(fields: [pointSettingId], references: [id])

  @@index([customerId], map: "loyalty_point_customerId_fkey")
  @@index([pointSettingId], map: "loyalty_point_pointSettingId_fkey")
  @@map("loyalty_point")
}

model Product {
  id                    String                 @id @default(cuid())
  code                  String                 @unique
  name                  String
  barcode               String?
  description           String?
  additionalDescription String?
  category              String?
  categoryId            String?
  subcategoryId         String?
  brandId               String?
  supplierId            String?
  unitOfMeasureId       String?
  unitPrice             Float                  @default(0)
  costPrice             Float                  @default(0)
  stockQuantity         Int                    @default(0)
  minStockLevel         Int                    @default(0)
  maxStockLevel         Int?
  isActive              Boolean                @default(true)
  salesOrder            String?
  autoCreateChildren    Boolean                @default(false)
  initialStock          Int                    @default(0)
  reorderPoint          Int                    @default(0)
  incomeAccountId       String?
  expenseAccountId      String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  inventoryTransactions InventoryTransaction[]
  invoiceItems          InvoiceItem[]
  history               ProductHistory[]
  purchaseOrderItems    PurchaseOrderItem[]
  requestItems          RequestItem[]
  posSaleItems          PosSaleItem[]

  @@map("product")
}

model ConversionFactor {
  id        String   @id @default(cuid())
  productId String
  unitName  String
  factor    Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("conversion_factor")
}

model Brand {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("brand")
}

model Category {
  id               String   @id @default(cuid())
  name             String   @unique
  description      String?
  parentCategoryId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("category")
}

model Supplier {
  id                String          @id @default(cuid())
  name              String          @unique
  contactPerson     String?
  email             String?
  phone             String?
  address           String?
  paymentTerms      String?
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  additionalInfo    String?
  contactFirstName  String?
  fax               String?
  isTaxExempt       Boolean         @default(false)
  paymentTermsValue String?
  phoneAlternative  String?
  vatInfo           String?
  purchaseOrders    PurchaseOrder[]

  @@map("supplier")
}

model UnitOfMeasure {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("unit_of_measure")
}

model Reminder {
  id        String    @id @default(cuid())
  title     String
  memo      String?
  date      DateTime
  endDate   DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  isRead    Boolean   @default(false)

  @@map("reminder")
}

model SalesUser {
  id        String   @id @default(cuid())
  name      String
  uniqueId  String   @unique
  username  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sales_user")
}

model UserPermission {
  id              String   @id @default(cuid())
  username        String   @unique
  firstName       String
  lastName        String
  contactNo       String?
  accountType     String
  permissions     String   @db.Text
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  password        String?
  designation     String?
  formPermissions String?
  chatRooms       ChatParticipant[]
  chatMessages    ChatMessage[]

  @@map("user_permission")
}

model BusinessProfile {
  id           String   @id @default(cuid())
  businessName String
  address      String?
  owner        String?
  contactPhone String?
  contactTel   String?
  email        String?
  tin          String?
  permit       String?
  logo         String?  @db.LongText
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  bankDetails  String?  @db.Text

  @@map("business_profile")
}

model BackupSchedule {
  id         String   @id @default(cuid())
  backupTime DateTime
  frequency  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("backup_schedule")
}

model Notification {
  id        String   @id @default(cuid())
  type      String
  title     String
  message   String?
  entityId  String?
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?

  @@index([userId])
  @@map("notification")
}

model BackupJob {
  id          String    @id @default(cuid())
  status      String
  filePath    String?
  fileName    String?
  fileSize    String?
  createdBy   String?
  log         String?   @db.Text
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@map("backup_job")
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  supplierId      String
  date            DateTime
  vendorAddress   String?             @db.Text
  shippingAddress String?             @db.Text
  taxType         String?             @default("default")
  comments        String?             @db.Text
  privateComments String?             @db.Text
  subtotal        Float               @default(0)
  taxTotal        Float               @default(0)
  total           Float               @default(0)
  status          String              @default("Open")
  depositAccount  String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  supplier        Supplier            @relation(fields: [supplierId], references: [id])
  items           PurchaseOrderItem[]

  @@index([supplierId], map: "purchase_order_supplierId_fkey")
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id                String        @id @default(cuid())
  purchaseOrderId   String
  productId         String?
  itemDescription   String
  quantity          Int
  unitPrice         Float
  tax               Float?
  total             Float
  category          String?
  sku               String?
  barcode           String?
  buyingUom         String?
  qtyPerCase        Int?
  offtake           Int?
  orderQty          Int?
  pieces            Int?
  costPricePerCase  Float?
  costPricePerPiece Float?
  discount1         Float?
  discount2         Float?
  discount3         Float?
  netCostAmount     Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  product           Product?      @relation(fields: [productId], references: [id])
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([productId], map: "purchase_order_item_productId_fkey")
  @@index([purchaseOrderId], map: "purchase_order_item_purchaseOrderId_fkey")
  @@map("purchase_order_item")
}

model Invoice {
  id               String        @id @default(cuid())
  invoiceNumber    String        @unique
  customerId       String
  customerPONumber String?
  date             DateTime
  dueDate          DateTime?
  terms            String?
  salesperson      String?
  depositAccount   String?
  billingAddress   String?       @db.Text
  shippingAddress  String?       @db.Text
  subtotal         Float         @default(0)
  total            Float         @default(0)
  status           String        @default("Pending")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  customer         Customer      @relation(fields: [customerId], references: [id])
  items            InvoiceItem[]

  @@index([customerId], map: "invoice_customerId_fkey")
  @@map("invoice")
}

model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  productId   String?
  description String
  quantity    Float
  unitPrice   Float
  total       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])

  @@index([invoiceId], map: "invoice_item_invoiceId_fkey")
  @@index([productId], map: "invoice_item_productId_fkey")
  @@map("invoice_item")
}

model ProductHistory {
  id        String   @id @default(cuid())
  productId String
  field     String
  oldValue  String?
  newValue  String?
  changedBy String?
  changedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "product_history_productId_fkey")
  @@map("product_history")
}

model InventoryTransaction {
  id          String      @id @default(cuid())
  productId   String
  type        String
  quantity    Int
  referenceId String?
  status      String      @default("Pending")
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  product     Product     @relation(fields: [productId], references: [id])
  kanbanCard  KanbanCard?

  @@index([productId], map: "inventory_transaction_productId_fkey")
  @@map("inventory_transaction")
}

model KanbanBoard {
  id        String         @id @default(cuid())
  title     String
  type      String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  columns   KanbanColumn[]

  @@map("kanban_board")
}

model KanbanColumn {
  id        String       @id @default(cuid())
  boardId   String
  title     String
  order     Int
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  cards     KanbanCard[]
  board     KanbanBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@index([boardId], map: "kanban_column_boardId_fkey")
  @@map("kanban_column")
}

model KanbanCard {
  id            String                @id @default(cuid())
  columnId      String
  content       String?
  position      Int
  transactionId String?               @unique
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  column        KanbanColumn          @relation(fields: [columnId], references: [id], onDelete: Cascade)
  transaction   InventoryTransaction? @relation(fields: [transactionId], references: [id])

  @@index([columnId], map: "kanban_card_columnId_fkey")
  @@map("kanban_card")
}

model Request {
  id            String        @id @default(cuid())
  requestNumber String        @unique
  requesterName String
  position      String?
  accountNo     String?
  businessUnit  String?
  department    String?
  purpose       String?
  chargeTo      String?
  amount        Float         @default(0)
  verifiedBy    String?
  approvedBy    String?
  processedBy   String?
  date          DateTime      @default(now())
  status        String        @default("To Verify")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  formName      String?       @db.VarChar(255)
  depositAccount String?
  items         RequestItem[]

  @@map("request")
}

model RequestItem {
  id          String   @id @default(cuid())
  requestId   String
  productId   String?
  description String
  quantity    Int
  unit        String?
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product? @relation(fields: [productId], references: [id])
  request     Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([productId], map: "request_item_productId_fkey")
  @@index([requestId], map: "request_item_requestId_fkey")
  @@map("request_item")
}

model PayablesLedger {
  id                 String   @id @default(cuid())
  date               DateTime
  reference          String?
  ledger             String?
  accountNumber      String?
  accountName        String?
  accountDescription String?
  debitAmount        Float    @default(0)
  creditAmount       Float    @default(0)
  user               String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("payables_ledger")
}

model PosSale {
  id             String        @id @default(cuid())
  receiptId      String        @unique
  date           DateTime
  amount         Float
  cashier        String?
  syncedToLedger Boolean       @default(false)
  subtotal       Float?        @default(0)
  tax            Float?        @default(0)
  discount       Float?        @default(0)
  paymentMethod  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          PosSaleItem[]

  @@map("pos_sales")
}

model PosSaleItem {
  id            String   @id @default(cuid())
  posSaleId     String
  productId     String?
  productName   String
  quantity      Float
  unitPrice     Float
  total         Float
  posSale       PosSale  @relation(fields: [posSaleId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id])

  @@index([posSaleId])
  @@index([productId])
  @@map("pos_sale_item")
}

model PosSyncLog {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  lastSyncedAt DateTime
  status       String   @default("SUCCESS") // SUCCESS or FAILED
  recordsAdded Int      @default(0)
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("pos_sync_log")
}

model CustomerPayment {
  id             String   @id @default(cuid())
  receiptId      String   @unique
  customerId     String
  date           DateTime
  amount         Float
  paymentMethod  String
  syncedToLedger Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@map("customer_payments")
}

model AuditLog {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  actionType    String   // e.g., "POS Batch Closed", "Journal Entry Posted", "Large Transaction Posted", "Manual Journal Created"
  transactionId String?  // ID of the related transaction or batch
  details       String?  @db.Text
  amount        Float?
  status        String   @default("To Audit") // "To Audit", "Audited"
  assignee      String?  // Username of the assigned auditor
  remarks       String?  @db.Text
  auditedBy     String?  // User who audited this
  auditedAt     DateTime?
  bankName      String?
  initiatedBy   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("audit_log")
}

enum BankTransactionType {
  CASH_IN
  CASH_OUT
  TRANSFER_IN
  TRANSFER_OUT
  ADJUSTMENT
}

enum BankTransactionStatus {
  DRAFT
  TO_AUDIT
  APPROVED
  POSTED
  RECONCILED
  CANCELLED
}

model BankTransaction {
  id              String                @id @default(cuid())
  bankAccountId   String
  bankAccount     BankAccount           @relation(fields: [bankAccountId], references: [id])
  transactionId   String?               // Link to the general journal transaction
  date            DateTime              @default(now())
  type            BankTransactionType
  status          BankTransactionStatus @default(DRAFT)
  amount          Float
  balanceAfter    Float
  reference       String?
  particulars     String?               @db.Text
  isCleared       Boolean               @default(false)
  clearedAt       DateTime?
  sourceType      String?               // POS, AP, AR, EXPENSE, TRANSFER, ADJUSTMENT
  sourceId        String?               // Link to original record
  offsetGlAccountId String?             // Offset GL Account for double-entry
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@map("bank_transactions")
}

model BankReconciliation {
  id               String      @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount @relation(fields: [bankAccountId], references: [id])
  statementDate    DateTime
  statementBalance Float
  systemBalance    Float
  difference       Float
  status           String      @default("OPEN") // OPEN, CLOSED
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@map("bank_reconciliations")
}


model Branch {
  id             String   @id @default(cuid())
  name           String   @unique
  code           String?  @unique
  type           String?  // Branch Type
  logoUrl        String?  @db.LongText // For base64 logo
  address        String?  @db.Text
  phone          String?  // Contact Number
  isActive       Boolean  @default(true)
  
  // Payment Details for Disbursement Slip
  payTo          String?   
  accountNumber  String?
  expenseAcct    String?
  receivables    String?
  depositAccount String?   
  othersField    String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  profit_center_id String? @db.VarChar(2)
  profitCenter     ProfitCenter? @relation(name: "BranchToProfitCenter", fields: [profit_center_id], references: [id])
  
  allocationWeights BranchAllocationWeight?
  transactions      Transaction[]

  @@map("branches")
}

model BranchAllocationWeight {
  id        String   @id @default(cuid())
  branchId  String   @unique
  branch    Branch   @relation(fields: [branchId], references: [id])
  weight    Float    @default(0) // Weight for weighted split (e.g., 20.0 for 20%)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("branch_allocation_weights")
}

model Employee {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  firstName        String
  lastName         String
  designation      String?
  branchesAssigned String?  @db.Text
  status           String   @default("Active")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("employee")
}

model ApiCache {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  data      String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("api_cache")
}

model ApiConnection {
  id            String       @id @default(cuid())
  name          String
  endpoint_url  String       @db.Text
  method        String       @default("GET")
  auth_type     String       @default("NONE")
  auth_key      String?
  auth_value    String?      @db.Text
  custom_headers String?     @db.Text
  description   String?      @db.Text
  is_active     Boolean      @default(true)
  last_tested   DateTime?
  last_status   String?
  response_time Int?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt
  call_logs     ApiCallLog[]

  @@map("api_connections")
}

model ApiCallLog {
  id            String        @id @default(cuid())
  connection_id String
  connection    ApiConnection @relation(fields: [connection_id], references: [id], onDelete: Cascade)
  status        String
  status_code   Int?
  response_time Int?
  error_message String?       @db.Text
  called_at     DateTime      @default(now())

  @@index([connection_id, called_at])
  @@map("api_call_logs")
}

model MachineStatus {
  id                       String    @id @default(cuid())
  machine_name             String
  ip_address               String
  machine_type             String    @default("CLIENT")
  location                 String?
  status                   String    @default("OFFLINE")
  last_seen                DateTime?
  offline_threshold_seconds Int      @default(120)
  os_info                  String?
  notes                    String?   @db.Text
  created_at               DateTime  @default(now())
  updated_at               DateTime  @updatedAt

  @@map("machine_status")
}

model DirectPayment {
  id               String                    @id @default(cuid())
  transaction_date DateTime
  pay_to           String?
  account_paid_from String
  method           String                    @default("Cash")
  amount           Float
  reference_number String?
  check_number     String?
  journal_memo     String?                   @db.Text
  status           String                    @default("POSTED")
  created_by       String?
  created_at       DateTime                  @default(now())
  updated_at       DateTime                  @updatedAt
  allocations      DirectPaymentAllocation[]

  @@index([transaction_date])
  @@index([status])
  @@map("direct_payments")
}

model DirectPaymentAllocation {
  id           String        @id @default(cuid())
  payment_id   String
  payment      DirectPayment @relation(fields: [payment_id], references: [id], onDelete: Cascade)
  account_name String
  amount       Float
  entry_type   String
  created_at   DateTime      @default(now())

  @@index([payment_id])
  @@map("direct_payment_allocations")
}

model ChatRoom {
  id        String   @id @default(cuid())
  name      String?  @db.VarChar(255)
  isGroup   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ChatParticipant[]
  messages     ChatMessage[]

  @@map("chat_rooms")
}

model ChatParticipant {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room ChatRoom       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user UserPermission @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@map("chat_participants")
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  senderId   String
  senderName String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  room        ChatRoom         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  attachments ChatAttachment[]
  user        UserPermission   @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}

model ChatAttachment {
  id        String   @id @default(cuid())
  messageId String
  fileName  String
  fileType  String
  fileUrl   String
  fileSize  Int
  createdAt DateTime @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("chat_attachments")
}
model ProfitCenter {
  id          String   @id @db.VarChar(2)
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  accounts     Account[]
  transactions Transaction[]
  branches     Branch[]      @relation(name: "BranchToProfitCenter")

  @@map("profit_centers")
}

model CostCenter {
  id          String   @id @db.VarChar(2)
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  accounts     Account[]
  transactions Transaction[]

  @@map("cost_centers")
}

// ─── PHASE 1: DOCUMENT ATTACHMENTS ───────────────────────────────────────────
model Document {
  id           String   @id @default(cuid())
  entityType   String   // 'invoice', 'purchase_order', 'request', 'transaction', 'customer', etc.
  entityId     String
  fileName     String
  originalName String
  mimeType     String
  size         Int
  uploadedBy   String
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
  @@map("documents")
}

// ─── PHASE 1: FIELD-LEVEL AUDIT TRAIL ────────────────────────────────────────
model AuditFieldLog {
  id          String   @id @default(cuid())
  entityType  String
  entityId    String
  action      String   // 'CREATE' | 'UPDATE' | 'DELETE'
  fieldName   String?
  oldValue    String?  @db.Text
  newValue    String?  @db.Text
  changedBy   String
  changedAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([changedAt])
  @@map("audit_field_logs")
}

// ─── PHASE 1: BACKUP SCHEDULE ────────────────────────────────────────────────
model AutoBackupLog {
  id        String   @id @default(cuid())
  fileName  String
  filePath  String
  sizeBytes BigInt
  status    String   // 'success' | 'failed'
  error     String?  @db.Text
  createdAt DateTime @default(now())

  @@map("auto_backup_logs")
}

// ─── PHASE 1: EMAIL NOTIFICATION LOG ─────────────────────────────────────────
model EmailLog {
  id          String   @id @default(cuid())
  to          String
  subject     String
  template    String
  entityType  String?
  entityId    String?
  status      String   // 'sent' | 'failed'
  error       String?  @db.Text
  sentAt      DateTime @default(now())

  @@map("email_logs")
}

// ─── PHASE 2: BUDGET MANAGEMENT ──────────────────────────────────────────────
model BudgetItem {
  id        String   @id @default(cuid())
  accountNo Int
  year      Int
  month     Int      // 1-12 for monthly, 0 = annual total
  amount    Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountNo, year, month])
  @@index([year, month])
  @@map("budget_items")
}

// ─── PHASE 2: FIXED ASSETS ───────────────────────────────────────────────────
model FixedAsset {
  id                 String    @id @default(cuid())
  assetCode          String    @unique
  name               String
  description        String?
  category           String?
  location           String?
  purchaseDate       DateTime
  cost               Float
  salvageValue       Float     @default(0)
  usefulLifeYears    Int
  depreciationMethod String    @default("Straight-Line")
  status             String    @default("Active")
  disposalDate       DateTime?
  disposalAmount     Float?
  accountNo          Int?
  accDepAccountNo    Int?
  depExpAccountNo    Int?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  depreciationEntries AssetDepreciationEntry[]

  @@map("fixed_assets")
}

model AssetDepreciationEntry {
  id              String     @id @default(cuid())
  assetId         String
  year            Int
  month           Int
  depreciationAmt Float
  bookValue       Float
  posted          Boolean    @default(false)
  postedAt        DateTime?
  createdAt       DateTime   @default(now())

  asset FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@unique([assetId, year, month])
  @@index([assetId])
  @@map("asset_depreciation_entries")
}

// ─── PHASE 2: RECURRING TRANSACTIONS ─────────────────────────────────────────
model RecurringTransaction {
  id              String    @id @default(cuid())
  description     String
  referencePrefix String    @default("REC")
  frequency       String    // monthly | weekly | yearly
  dayOfMonth      Int?      // 1-31 for monthly
  nextRunDate     DateTime
  lastRunDate     DateTime?
  isActive        Boolean   @default(true)
  lines           String    @db.Text // JSON: [{accountNo, debit, credit, particulars}]
  createdBy       String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("recurring_transactions")
}

// ─── PHASE 2: AR AGING — DUNNING LOG ─────────────────────────────────────────
model DunningLog {
  id         String   @id @default(cuid())
  customerId String
  invoiceId  String?
  level      Int      // 1 = 1st notice, 2 = 2nd notice, 3 = final
  sentTo     String
  sentAt     DateTime @default(now())

  @@index([customerId])
  @@map("dunning_logs")
}

// ─── PHASE 3: PAYROLL ─────────────────────────────────────────────────────────
model PayrollPeriod {
  id        String    @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  payDate   DateTime
  status    String    @default("Draft") // Draft | Posted | Paid
  createdBy String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  entries PayrollEntry[]

  @@map("payroll_periods")
}

model PayrollEntry {
  id                  String        @id @default(cuid())
  periodId            String
  employeeId          String
  employeeName        String
  designation         String?
  basicPay            Float
  allowances          Float         @default(0)
  grossPay            Float
  sssEmployee         Float         @default(0)
  sssEmployer         Float         @default(0)
  philhealthEmployee  Float         @default(0)
  philhealthEmployer  Float         @default(0)
  pagibigEmployee     Float         @default(0)
  pagibigEmployer     Float         @default(0)
  withholdingTax      Float         @default(0)
  otherDeductions     Float         @default(0)
  totalDeductions     Float         @default(0)
  netPay              Float
  posted              Boolean       @default(false)

  period PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@map("payroll_entries")
}

// ─── PHASE 3: GOODS RECEIPT NOTE (3-WAY MATCHING) ────────────────────────────
model GoodsReceiptNote {
  id           String   @id @default(cuid())
  grnNumber    String   @unique
  poId         String
  supplierId   String
  receivedDate DateTime
  status       String   @default("Draft") // Draft | Confirmed | Matched
  receivedBy   String
  notes        String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items GoodsReceiptItem[]

  @@map("goods_receipt_notes")
}

model GoodsReceiptItem {
  id          String   @id @default(cuid())
  grnId       String
  poItemId    String?
  productId   String?
  description String
  orderedQty  Float
  receivedQty Float
  unitPrice   Float    @default(0)

  grn GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)

  @@index([grnId])
  @@map("goods_receipt_items")
}

// ─── PHASE 3: STOCK TRANSFERS ─────────────────────────────────────────────────
model StockTransfer {
  id             String   @id @default(cuid())
  transferNumber String   @unique
  fromBranch     String
  toBranch       String
  transferDate   DateTime
  status         String   @default("Pending") // Pending | Completed | Cancelled
  transferredBy  String
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items StockTransferItem[]

  @@map("stock_transfers")
}

model StockTransferItem {
  id         String   @id @default(cuid())
  transferId String
  productId  String
  quantity   Float
  unitCost   Float    @default(0)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("stock_transfer_items")
}

// ─── PHASE 3: BANK STATEMENT IMPORT (RECONCILIATION) ─────────────────────────
model BankStatementImport {
  id            String   @id @default(cuid())
  bankAccountId String
  fileName      String
  importedAt    DateTime @default(now())
  lineCount     Int      @default(0)
  matchedCount  Int      @default(0)

  lines BankStatementLine[]

  @@map("bank_statement_imports")
}

model BankStatementLine {
  id          String   @id @default(cuid())
  importId    String
  txDate      DateTime
  description String   @db.Text
  debit       Float    @default(0)
  credit      Float    @default(0)
  balance     Float?
  reference   String?
  matched     Boolean  @default(false)
  matchedTxId String?

  import BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId])
  @@map("bank_statement_lines")
}

// ─── PHASE 5: APPROVAL WORKFLOW ENGINE ───────────────────────────────────────
model ApprovalWorkflow {
  id          String   @id @default(cuid())
  name        String
  description String?
  entityType  String   // 'request' | 'purchase_order' | 'invoice' | 'payment'
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps    ApprovalStep[]
  requests ApprovalRequest[]

  @@map("approval_workflows")
}

model ApprovalStep {
  id           String @id @default(cuid())
  workflowId   String
  level        Int    // 1 = first approver, 2 = second, etc.
  label        String // e.g. "Verify", "Approve", "Final Approval"
  minAmount    Float? // null = no min
  maxAmount    Float? // null = no max
  requiredRole String // accountType or formPermission that can approve
  escalateAfterHours Int @default(24) // escalate if not acted on

  workflow  ApprovalWorkflow   @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  decisions ApprovalDecision[]

  @@index([workflowId])
  @@map("approval_steps")
}

model ApprovalRequest {
  id           String    @id @default(cuid())
  workflowId   String
  entityType   String
  entityId     String
  entityRef    String?   // human-readable reference number
  amount       Float     @default(0)
  currentLevel Int       @default(1)
  status       String    @default("Pending") // Pending | Approved | Rejected | Cancelled
  requestedBy  String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workflow  ApprovalWorkflow @relation(fields: [workflowId], references: [id])
  decisions ApprovalDecision[]

  @@index([entityType, entityId])
  @@index([status])
  @@map("approval_requests")
}

model ApprovalDecision {
  id         String   @id @default(cuid())
  requestId  String
  stepId     String
  level      Int
  decidedBy  String
  decision   String   // 'Approved' | 'Rejected' | 'Returned'
  remarks    String?  @db.Text
  decidedAt  DateTime @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  step    ApprovalStep    @relation(fields: [stepId], references: [id])

  @@index([requestId])
  @@map("approval_decisions")
}

// ─── PHASE 5: RBAC PER MODULE ────────────────────────────────────────────────
model ModulePermission {
  id        String   @id @default(cuid())
  role      String   // accountType value
  module    String   // 'invoices' | 'payroll' | 'reports' | etc.
  canView   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canEdit   Boolean  @default(false)
  canDelete Boolean  @default(false)
  canPost   Boolean  @default(false)   // post to GL
  canApprove Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, module])
  @@map("module_permissions")
}

// ─── PHASE 5: MULTI-CURRENCY ─────────────────────────────────────────────────
model Currency {
  id        String   @id @default(cuid())
  code      String   @unique // USD, EUR, JPY etc.
  name      String
  symbol    String   @default("")
  isBase    Boolean  @default(false) // PHP is base
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  rates ExchangeRate[]

  @@map("currencies")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyId   String
  rateDate     DateTime
  rateToBase   Float    // 1 unit of this currency = X PHP
  createdAt    DateTime @default(now())

  currency Currency @relation(fields: [currencyId], references: [id])

  @@unique([currencyId, rateDate])
  @@index([rateDate])
  @@map("exchange_rates")
}

// ─── PHASE 5: API GATEWAY ────────────────────────────────────────────────────
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  keyHash     String    @unique
  keyPrefix   String    // first 8 chars for display (e.g. "ljma_abc")
  permissions String    @db.Text  // JSON array: ['invoices:read','customers:read']
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@map("api_keys")
}

model WebhookSubscription {
  id        String   @id @default(cuid())
  name      String
  url       String   @db.Text
  events    String   @db.Text  // JSON: ['invoice.created','payment.received']
  secret    String   // for HMAC signature verification
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deliveries WebhookDelivery[]

  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String   @id @default(cuid())
  subscriptionId String
  event          String
  payload        String   @db.LongText
  statusCode     Int?
  responseBody   String?  @db.Text
  success        Boolean  @default(false)
  attemptCount   Int      @default(1)
  deliveredAt    DateTime @default(now())

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@map("webhook_deliveries")
}

// ─── PHASE 5: POS INTEGRATION ────────────────────────────────────────────────
model PosEodReconciliation {
  id             String   @id @default(cuid())
  date           DateTime
  machineId      String?
  totalSales     Float    @default(0)
  totalReceipts  Int      @default(0)
  journalPosted  Boolean  @default(false)
  variance       Float    @default(0)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())

  @@index([date])
  @@map("pos_eod_reconciliations")
}

// ─── PHASE 5: AI ANOMALY LOG ─────────────────────────────────────────────────
model AnomalyLog {
  id          String   @id @default(cuid())
  entityType  String   // 'transaction' | 'invoice' | 'expense'
  entityId    String
  entityRef   String?
  anomalyType String   // 'amount_spike' | 'duplicate' | 'unusual_account' | 'weekend'
  severity    String   // 'low' | 'medium' | 'high'
  description String   @db.Text
  amount      Float?
  baseline    Float?   // expected/average amount
  reviewed    Boolean  @default(false)
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([reviewed])
  @@map("anomaly_logs")
}


